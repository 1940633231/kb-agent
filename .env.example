# 生成（LLM）用：DashScope / Qwen
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_MODEL=qwen-flash

# 第二阶段（Checkpointer / Store）用；配合 persistence/docker-compose.yml
# 容器把 5432 映射到宿主 5433，避免与本机其他 Postgres 冲突
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=kb_agent
POSTGRES_PASSWORD=kb_agent
POSTGRES_DB=kb_agent
