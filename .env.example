# 统一 LLM 后端（任意 OpenAI-compatible /chat/completions 端点）
# 示例为 DashScope 兼容端点；也可替换为 OpenAI / DeepSeek / vLLM 等。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-flash

# 兼容旧配置：仅当 LLM_* 未设置时，load_env() 会从下列变量迁移。
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-flash

# 第二阶段（Checkpointer / Store）用；配合 persistence/docker-compose.yml
# 容器把 5432 映射到宿主 5433，避免与本机其他 Postgres 冲突
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=kb_agent
POSTGRES_PASSWORD=kb_agent
POSTGRES_DB=kb_agent
